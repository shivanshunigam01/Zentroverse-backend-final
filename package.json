{
  "name": "zentroverse-backend",
  "version": "1.0.0",
  "description": "Node.js + Express + MongoDB backend for Zentroverse website",
  "type": "module",
  "scripts": {
    "postinstall": "npm run hr:install && node scripts/verify-peopleflow.mjs --soft",
    "verify:peopleflow": "node scripts/verify-peopleflow.mjs",
    "seed:hr-admin": "node scripts/seed-peopleflow-admin.mjs",
    "seed:hr-demo": "node scripts/seed-peopleflow-demo.mjs",
    "predev": "npm run hr:build",
    "dev": "node --watch src/server.js",
    "prestart": "npm run hr:build",
    "start": "node src/server.js",
    "deploy": "npm install && npm run hr:build",
    "hr:install": "npm install --prefix hr",
    "hr:build": "npm run build --prefix hr",
    "hr:test": "npm test --prefix hr"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
