# Server
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,https://zentroverse.com,https://www.zentroverse.com,https://newbackend.zentroverse.com

# Production EC2: copy this file to .env and set YOUR_PASSWORD (never commit .env)

# MongoDB Atlas (Zentroverse + HR) — set password in URI, never commit .env
MONGODB_URI=mongodb+srv://manmohanjha2022_db_user:YOUR_PASSWORD@zentroverse.bcq4bws.mongodb.net/zentroverse?retryWrites=true&w=majority&appName=zentroverse
USE_MEMORY_DB=false
# Local fallback only: USE_MEMORY_DB=true and mongodb://127.0.0.1:27017/zentroverse

# Admin API
ADMIN_PANEL_TOKEN=ZV-ADMIN-2026-DEMO

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=zentroverse

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Lead notifications
LEAD_WEBHOOK_URL=
WHATSAPP_NOTIFY_URL=
ADMIN_NOTIFY_EMAIL=digital@zentroverse.com

# JWT (admin panel Bearer auth + ZentroFlow)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@zentroverse.in
ADMIN_PASSWORD=Zentro@2026

# PeopleFlow /api/v1 (min 16 chars each; 32+ in production)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
PEOPLEFLOW_APP_URL=https://www.zentroverse.com
ALLOW_PUBLIC_REGISTER=true
